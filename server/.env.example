NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/city
CORS_ORIGINS=http://localhost:3000

# Minimum 32 characters each, and all 3 secrets MUST be different
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_here
COOKIE_SECRET=your_super_secret_cookie_parser_key_min_32_characters_here
CSRF_SECRET=your_super_secret_csrf_protection_key_min_32_characters_here

# Optional Redis
REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379

# Optional Default Accounts
# DEFAULT_SUPER_ADMIN_NOM_COMPLET=Super Admin
# DEFAULT_SUPER_ADMIN_EMAIL=superadmin@example.com
# DEFAULT_SUPER_ADMIN_PASSWORD=SuperAdminPassword123!
