NODE_ENV=development
# Render injects PORT automatically; only needed locally.
PORT=4000
# Production requires credentials in the URI (user:password@...).
MONGODB_URI=mongodb://localhost:27017/city
# Comma-separated. Production only accepts https:// origins.
CORS_ORIGINS=http://localhost:3000

# Minimum 32 characters each, and all 3 secrets MUST be different
JWT_ACCESS_SECRET=
COOKIE_SECRET=
CSRF_SECRET=

# Optional
# JWT_ACCESS_TTL_SECONDS=900
# JWT_ISSUER=project_city
# JWT_AUDIENCE=project_city
# REFRESH_TOKEN_TTL_DAYS=7
# Set to 1 behind a reverse proxy (Render, nginx, Cloudflare...)
# TRUST_PROXY=false
# SOCKET_REQUIRE_AUTH=true

# Optional Redis
REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379

# Optional default accounts, created on startup only when none exist.
# Passwords: 12 to 128 characters.
# DEFAULT_SUPER_ADMIN_NOM_COMPLET=
# DEFAULT_SUPER_ADMIN_EMAIL=
# DEFAULT_SUPER_ADMIN_PASSWORD=

# All DEFAULT_ADMIN_* profile fields must be set together (TELEPHONE: 8 to 15 digits, optional leading +).
# DEFAULT_ADMIN_PRENOM=
# DEFAULT_ADMIN_NOM=
# DEFAULT_ADMIN_EMAIL=
# DEFAULT_ADMIN_TELEPHONE=
# DEFAULT_ADMIN_WILAYA=
# DEFAULT_ADMIN_DAIRA=
# DEFAULT_ADMIN_BALADIA=
# DEFAULT_ADMIN_PASSWORD=

# Same rules as DEFAULT_ADMIN_*; a sub admin is only created when this block is filled in.
# DEFAULT_SUB_ADMIN_PRENOM=
# DEFAULT_SUB_ADMIN_NOM=
# DEFAULT_SUB_ADMIN_EMAIL=
# DEFAULT_SUB_ADMIN_TELEPHONE=
# DEFAULT_SUB_ADMIN_WILAYA=
# DEFAULT_SUB_ADMIN_DAIRA=
# DEFAULT_SUB_ADMIN_BALADIA=
# DEFAULT_SUB_ADMIN_PASSWORD=
